# ── Private working notes ────────────────────────────────────────────────
# Raw research and audience notes stay local; curated docs live in docs/.
research/

# ── Secrets and local configuration ──────────────────────────────────────
.env
.env.*
!.env.example
!frontend/.env.mock

# ── Local databases ──────────────────────────────────────────────────────
backstop.db
backstop.db.bak*
ci.db
*.db-journal

