# Copy to .env. Nothing here is required for the demo.

# Real models for $0 (see docs/free-tier-models.md). None is required: without
# any of these, runs use the simulated adapter or replay recorded cassettes.
# Local Ollama needs no key — just `ollama serve` and a pulled model.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Paid, optional
ANTHROPIC_API_KEY=

# simulated | cassette | live — default adapter for non-simulated models
BACKSTOP_DEFAULT_ADAPTER=cassette

# Users: "user:password:role,..." — a stub for SSO (roles: analyst, engineer, admin).
# Audit rows name the user and role, so give the demo operator a real name.
# The password == username defaults below are for localhost ONLY:
# scripts/demo-tunnel.* refuses to publish while any account still uses them.
BACKSTOP_USERS=analyst:analyst:analyst,engineer:engineer:engineer,admin:admin:admin
# Example for a public demo (use long random passwords; ':' is allowed, ',' is not):
# BACKSTOP_USERS=pavan:<long-password>:engineer,reviewer:<long-password>:analyst,admin:<long-password>:admin

# The one public port (nginx: UI + /api). Bound to 127.0.0.1; a tunnel publishes it.
BACKSTOP_UI_PORT=5173

# Local run without Docker (SQLite file in the repo root)
# BACKSTOP_DATABASE_URL=sqlite:///./backstop.db

# Crawler: false = replay frozen snapshots only (the demo never touches the network)
BACKSTOP_CRAWLER_LIVE=false
